APP_NAME="ICCE Rentas y Servicios"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_TIMEZONE=America/Monterrey

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de datos (contenedor `db`) ---
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=icce
DB_USERNAME=icce
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# --- Puertos publicados en el host ---
APP_PORT=80
APP_PORT_ALT=8080
DB_PORT_HOST=3307
MAILPIT_UI_PORT=8025
VITE_PORT=5173

# --- Cache / sesiones / colas sobre Redis ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Correo: Mailpit en local, Mailgun/SendGrid en producción ---
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@icce.com.mx"
MAIL_FROM_NAME="${APP_NAME}"

# --- Almacenamiento S3 (fichas técnicas, imágenes WebP) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Pasarela de pagos (REQ-03) ---
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
OPENPAY_MERCHANT_ID=
OPENPAY_PRIVATE_KEY=
OPENPAY_PUBLIC_KEY=
OPENPAY_SANDBOX=true

# --- Reglas de negocio del carrito híbrido (REQ-01 / REQ-02) ---
ICCE_MAX_DIRECT_PURCHASE=10

# --- Contacto ---
ICCE_WHATSAPP_NUMBER=
ICCE_SALES_EMAIL=ventas@icce.com.mx

VITE_APP_NAME="${APP_NAME}"
